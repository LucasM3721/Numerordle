{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "numerordle",
  "main": "src/index.js",
  "compatibility_date": "2025-06-01",

  // El front es estático; cualquier ruta que no sea /api/* cae en index.html
  // para que /r/ABC12 (el link que le pasás a tus amigos) funcione.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Una sala = un Durable Object. Estado aislado, websockets propios.
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" }
    ]
  },

  // new_sqlite_classes (y no new_classes) es lo que habilita el plan gratis.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] }
  ],

  // Límites de ritmo, por IP. Ojo con dos cosas:
  //   - El período solo puede ser 10 o 60 segundos.
  //   - El conteo es *por centro de datos*, no global. Alguien distribuido lo
  //     esquiva en parte; para el nivel de amenaza de un juego con link público
  //     alcanza, pero no es una barrera absoluta.
  // CREAR_SALA es el que importa: cada sala es un Durable Object.
  // AVISO no limita a nadie, se usa para no mandar mil notificaciones seguidas.
  "ratelimits": [
    { "name": "CREAR_SALA", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "ABRIR_SALA", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "AVISO", "namespace_id": "1003", "simple": { "limit": 1, "period": 60 } }
  ],

  // Cada versión publicada podría quedar accesible en su propia URL pública.
  // Hoy Cloudflare no las emite para Workers con Durable Objects, así que esto
  // probablemente no cambie nada; queda escrito porque con el link dando
  // vueltas en público no queremos versiones viejas sirviendo por su cuenta,
  // y el despliegue de este proyecto va derecho a producción igual.
  "preview_urls": false,

  "observability": { "enabled": true }
}
