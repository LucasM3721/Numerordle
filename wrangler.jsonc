{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "numerordle",
  "main": "src/index.js",
  "compatibility_date": "2025-06-01",

  // El front es estático; cualquier ruta que no sea /api/* cae en index.html
  // para que /r/ABC12 (el link que le pasás a tus amigos) funcione.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Una sala = un Durable Object. Estado aislado, websockets propios.
  // Un desafío del día = otro, uno por jugador y por día. Va en una clase
  // aparte y no como un modo de GameRoom porque ahí el orden de los jugadores
  // ES el círculo, y el desafío no tiene círculo.
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" },
      { "name": "RETOS", "class_name": "RetoDelDia" }
    ]
  },

  // new_sqlite_classes (y no new_classes) es lo que habilita el plan gratis.
  // Las migraciones se agregan al final y no se editan: cada tag ya corrió.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["RetoDelDia"] }
  ],

  // Dos veces por día, en UTC. El cupo diario del plan gratis se repone a la
  // medianoche UTC, así que las 22:00 son dos horas antes: el número todavía
  // sirve para hacer algo. Las 12:00 son el control de mitad de día.
  "triggers": { "crons": ["0 12,22 * * *"] },

  // Límites de ritmo, por IP. Ojo con dos cosas:
  //   - El período solo puede ser 10 o 60 segundos.
  //   - El conteo es *por centro de datos*, no global. Alguien distribuido lo
  //     esquiva en parte; para el nivel de amenaza de un juego con link público
  //     alcanza, pero no es una barrera absoluta.
  // CREAR_SALA es el que importa: cada sala es un Durable Object.
  // AVISO no limita a nadie, se usa para no mandar mil notificaciones seguidas.
  "ratelimits": [
    { "name": "CREAR_SALA", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "ABRIR_SALA", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "AVISO", "namespace_id": "1003", "simple": { "limit": 1, "period": 60 } },
    // Un desafío entero son 12 intentos: 60 por minuto es holgado para jugar y
    // corta al que quiera hacer girar el Durable Object a mano.
    { "name": "RETO", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } }
  ],

  // Cada versión publicada podría quedar accesible en su propia URL pública.
  // Hoy Cloudflare no las emite para Workers con Durable Objects, así que esto
  // probablemente no cambie nada; queda escrito porque con el link dando
  // vueltas en público no queremos versiones viejas sirviendo por su cuenta,
  // y el despliegue de este proyecto va derecho a producción igual.
  "preview_urls": false,

  // Una fila por jugador de cada partida terminada. Existe porque los logs de
  // `observability` duran tres días en el plan gratis: son una ventana móvil,
  // y para calibrar al bot contra jugadores reales hace falta un histórico.
  // Acá se guardan noventa días y se consultan por SQL.
  "analytics_engine_datasets": [
    { "binding": "PARTIDAS", "dataset": "numerordle_partidas" }
  ],

  "observability": { "enabled": true }
}
